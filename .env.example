# Copy to .env and adjust. All values are optional.

# Topic: emanual (Samsung TV manual) or techqa (IBM technical support)
TOPIC=emanual

# Base model. The unsloth mirror is ungated and byte-identical to meta-llama/Llama-3.1-8B-Instruct.
# To use Meta's gated repo instead, set MODEL=meta-llama/Llama-3.1-8B-Instruct and HF_TOKEN.
MODEL=unsloth/Llama-3.1-8B-Instruct
MODEL_REVISION=4699cc75b550f9c6f3173fb80f4703b62d946aa5
HF_TOKEN=

# vLLM image and GPU share. Defaults suit a dedicated NVIDIA GPU with >= 24 GB.
# NVIDIA DGX Spark (tested): uncomment the three lines below instead. NVIDIA's image must keep its own
# entrypoint script in front of "vllm serve", or CUDA fails with a PTX toolchain error.
VLLM_IMAGE=vllm/vllm-openai:v0.29.0
VLLM_ENTRYPOINT=vllm serve
GPU_UTIL=0.85
# VLLM_IMAGE=nvcr.io/nvidia/vllm:26.09-py3
# VLLM_ENTRYPOINT=/opt/nvidia/nvidia_entrypoint.sh vllm serve
# GPU_UTIL=0.5

API_PORT=8021
WEBUI_PORT=3001
